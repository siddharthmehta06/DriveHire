generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  HATCHBACK
  SEDAN
  SUV
  MPV
  LUXURY
}

enum VerificationStatus {
  UNVERIFIED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum DocumentType {
  RC
  INSURANCE
  LICENSE
  PERMIT
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum InsuranceType {
  COMMERCIAL
  PRIVATE
}

enum NotificationType {
  DOC_EXPIRY_REMINDER
  DOC_APPROVED
  DOC_REJECTED
  VEHICLE_VERIFIED
  VEHICLE_REJECTED
  BOOKING_REQUESTED
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  PAYMENT_RECEIPT
  CASHOUT_PROCESSED
  GENERAL
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  vehicles     Vehicle[]
  vehicleDocuments VehicleDocument[] @relation("DocumentOwner")
  notifications Notification[]

  @@map("users")
}

model Vehicle {
  id                  String    @id @default(uuid())
  ownerId             String
  owner               User      @relation(fields: [ownerId], references: [id])
  make                String
  model               String
  year                Int
  registrationNumber String    @unique
  vehicleType         VehicleType
  seatCapacity        Int
  photoUrls           String[]
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  isAvailable         Boolean   @default(true)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  documents           VehicleDocument[]

  @@index([ownerId])
  @@map("vehicles")
}

model VehicleDocument {
  id               String         @id @default(uuid())
  ownerId          String
  owner            User           @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  vehicleId        String?
  vehicle          Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  type             DocumentType
  insuranceType    InsuranceType?
  documentNumber   String
  issueDate        DateTime?
  expiryDate       DateTime
  fileUrl          String
  originalName     String
  mimeType         String
  sizeBytes        Int
  status           DocumentStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionReason  String?
  supersededAt     DateTime?
  lastReminderDays Int?
  createdAt        DateTime       @default(now())

  @@index([vehicleId, type])
  @@index([status, expiryDate])
  @@index([ownerId, vehicleId, type, supersededAt])
  @@map("vehicle_documents")
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  body         String
  data         Json?
  readAt       DateTime?
  emailSentAt  DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}
