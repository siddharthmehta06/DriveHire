generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  HATCHBACK
  SEDAN
  SUV
  MPV
  LUXURY
}

enum VerificationStatus {
  UNVERIFIED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum DocumentType {
  RC
  INSURANCE
  LICENSE
  PERMIT
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum InsuranceType {
  COMMERCIAL
  PRIVATE
}

enum BackgroundCheckStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditTargetType {
  DOCUMENT
  VEHICLE
  DRIVER
}

enum NotificationType {
  DOC_EXPIRY_REMINDER
  DOC_APPROVED
  DOC_REJECTED
  VEHICLE_VERIFIED
  VEHICLE_REJECTED
  BOOKING_REQUESTED
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  PAYMENT_RECEIPT
  CASHOUT_PROCESSED
  GENERAL
}

enum RideStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingType {
  RIDE
  RENTAL
}

enum BookingStatus {
  PENDING
  ACCEPTED
  CONFIRMED
  REJECTED
  CANCELLED
  ACTIVE
  COMPLETED
}

enum PaymentMethod {
  ONLINE
  CASH
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FLAT
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  vehicles     Vehicle[]
  vehicleDocuments VehicleDocument[] @relation("DocumentOwner")
  notifications Notification[]
  driverProfile DriverProfile?
  rides         CarpoolRide[]
  bookings      Booking[]
  payerPayments Payment[]       @relation("PayerPayments")
  payeePayments Payment[]       @relation("PayeePayments")
  pricingConfigsUpdated PricingConfig[]
  earningEntries EarningEntry[]
  earningsAccount EarningsAccount?

  @@map("users")
}

model DriverProfile {
  userId                 String               @id
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber          String?
  backgroundCheckStatus  BackgroundCheckStatus @default(PENDING)
  updatedAt              DateTime             @updatedAt

  @@map("driver_profiles")
}

model Vehicle {
  id                  String    @id @default(uuid())
  ownerId             String
  owner               User      @relation(fields: [ownerId], references: [id])
  make                String
  model               String
  year                Int
  registrationNumber String    @unique
  vehicleType         VehicleType
  seatCapacity        Int
  photoUrls           String[]
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  isAvailable         Boolean   @default(true)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  documents           VehicleDocument[]
  rides               CarpoolRide[]

  @@index([ownerId])
  @@map("vehicles")
}

model VerificationAudit {
  id         String          @id @default(uuid())
  adminId    String
  targetType AuditTargetType
  targetId   String
  action     String
  reason     String?
  createdAt  DateTime        @default(now())

  @@index([targetType, targetId])
  @@map("verification_audits")
}

model VehicleDocument {
  id               String         @id @default(uuid())
  ownerId          String
  owner            User           @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  vehicleId        String?
  vehicle          Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  type             DocumentType
  insuranceType    InsuranceType?
  documentNumber   String
  issueDate        DateTime?
  expiryDate       DateTime
  fileUrl          String
  originalName     String
  mimeType         String
  sizeBytes        Int
  status           DocumentStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionReason  String?
  supersededAt     DateTime?
  lastReminderDays Int?
  createdAt        DateTime       @default(now())

  @@index([vehicleId, type])
  @@index([status, expiryDate])
  @@index([ownerId, vehicleId, type, supersededAt])
  @@map("vehicle_documents")
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  body         String
  data         Json?
  readAt       DateTime?
  emailSentAt  DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model CarpoolRide {
  id             String     @id @default(uuid())
  driverId       String
  driver         User       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  originText     String
  originLat      Decimal    @db.Decimal(9, 6)
  originLng      Decimal    @db.Decimal(9, 6)
  destText       String
  destLat        Decimal    @db.Decimal(9, 6)
  destLng        Decimal    @db.Decimal(9, 6)
  distanceKm     Decimal?   @db.Decimal(7, 2)
  departureTime  DateTime
  totalSeats     Int
  availableSeats Int
  costPerSeat    Decimal    @db.Decimal(10, 2)
  notes          String?
  status         RideStatus @default(OPEN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  bookings       RideBooking[]
  location       RideLocation?

  @@index([status, departureTime])
  @@index([driverId])
  @@index([vehicleId, status, departureTime])
  @@map("carpool_rides")
}

model Booking {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         BookingType
  status       BookingStatus @default(PENDING)
  bookingDate  DateTime      @default(now())
  cancelledAt  DateTime?
  cancelReason String?
  updatedAt    DateTime      @updatedAt
  rideBooking  RideBooking?
  payment      Payment?

  @@index([userId, status])
  @@map("bookings")
}

model RideBooking {
  bookingId   String      @id
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rideId      String
  ride        CarpoolRide @relation(fields: [rideId], references: [id], onDelete: Cascade)
  passengerId String
  seatsBooked Int
  pickupNote  String?
  active      Boolean     @default(true)

  @@index([rideId])
  @@map("ride_bookings")
}

model RideLocation {
  rideId    String      @id
  ride      CarpoolRide @relation(fields: [rideId], references: [id], onDelete: Cascade)
  lat       Decimal     @db.Decimal(9, 6)
  lng       Decimal     @db.Decimal(9, 6)
  updatedAt DateTime    @updatedAt

  @@map("ride_locations")
}

model Payment {
  id                String         @id @default(uuid())
  bookingId         String         @unique
  payerId           String
  payeeId           String
  baseAmount        Decimal        @db.Decimal(10, 2)
  discountAmount    Decimal        @default(0) @db.Decimal(10, 2)
  amount            Decimal        @db.Decimal(10, 2)
  commissionRatePct Decimal        @db.Decimal(5, 2)
  commissionAmount  Decimal        @db.Decimal(10, 2)
  payeeAmount       Decimal        @db.Decimal(10, 2)
  promoCodeId       String?
  method            PaymentMethod?
  status            PaymentStatus  @default(PENDING)
  gatewayProvider   String?
  gatewayOrderId    String?        @unique
  gatewayPaymentId  String?
  failureReason     String?
  receiptNumber     String?        @unique
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  booking           Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payer             User           @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Cascade)
  payee             User           @relation("PayeePayments", fields: [payeeId], references: [id], onDelete: Cascade)
  promoCode         PromoCode?     @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  earningEntry      EarningEntry?

  @@map("payments")
}

model PromoCode {
  id          String       @id @default(uuid())
  code        String       @unique
  discountType DiscountType
  value       Decimal      @db.Decimal(10, 2)
  maxDiscount Decimal?     @db.Decimal(10, 2)
  minAmount   Decimal?     @db.Decimal(10, 2)
  usageLimit  Int?
  usedCount   Int          @default(0)
  validFrom   DateTime
  validUntil  DateTime
  active      Boolean      @default(true)
  payments    Payment[]

  @@map("promo_codes")
}

model PricingConfig {
  id                Int      @id @default(1)
  commissionRatePct Decimal  @default(10) @db.Decimal(5, 2)
  updatedById       String?
  updatedBy         User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt         DateTime @updatedAt

  @@map("pricing_config")
}

model EarningEntry {
  id               String      @id @default(uuid())
  earnerId         String
  earner           User        @relation(fields: [earnerId], references: [id], onDelete: Cascade)
  paymentId        String      @unique
  payment          Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bookingType      BookingType
  grossAmount      Decimal     @db.Decimal(10, 2)
  commissionAmount Decimal     @db.Decimal(10, 2)
  netAmount        Decimal     @db.Decimal(10, 2)
  withdrawable     Boolean
  createdAt        DateTime    @default(now())

  @@index([earnerId, createdAt])
  @@map("earning_entries")
}

model EarningsAccount {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawableBalance Decimal  @default(0) @db.Decimal(12, 2)
  totalEarned         Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt           DateTime @updatedAt

  @@map("earnings_accounts")
}
