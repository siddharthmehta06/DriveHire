generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  HATCHBACK
  SEDAN
  SUV
  MPV
  LUXURY
}

enum VerificationStatus {
  UNVERIFIED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum DocumentType {
  RC
  INSURANCE
  LICENSE
  PERMIT
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum InsuranceType {
  COMMERCIAL
  PRIVATE
}

enum BackgroundCheckStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditTargetType {
  DOCUMENT
  VEHICLE
  DRIVER
}

enum NotificationType {
  DOC_EXPIRY_REMINDER
  DOC_APPROVED
  DOC_REJECTED
  VEHICLE_VERIFIED
  VEHICLE_REJECTED
  BOOKING_REQUESTED
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  PAYMENT_RECEIPT
  CASHOUT_PROCESSED
  GENERAL
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  vehicles     Vehicle[]
  vehicleDocuments VehicleDocument[] @relation("DocumentOwner")
  notifications Notification[]
  driverProfile DriverProfile?

  @@map("users")
}

model DriverProfile {
  userId                 String               @id
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber          String?
  backgroundCheckStatus  BackgroundCheckStatus @default(PENDING)
  updatedAt              DateTime             @updatedAt

  @@map("driver_profiles")
}

model Vehicle {
  id                  String    @id @default(uuid())
  ownerId             String
  owner               User      @relation(fields: [ownerId], references: [id])
  make                String
  model               String
  year                Int
  registrationNumber String    @unique
  vehicleType         VehicleType
  seatCapacity        Int
  photoUrls           String[]
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  isAvailable         Boolean   @default(true)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  documents           VehicleDocument[]
  rides               CarpoolRide[]

  @@index([ownerId])
  @@map("vehicles")
}

model VerificationAudit {
  id         String          @id @default(uuid())
  adminId    String
  targetType AuditTargetType
  targetId   String
  action     String
  reason     String?
  createdAt  DateTime        @default(now())

  @@index([targetType, targetId])
  @@map("verification_audits")
}

model VehicleDocument {
  id               String         @id @default(uuid())
  ownerId          String
  owner            User           @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  vehicleId        String?
  vehicle          Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  type             DocumentType
  insuranceType    InsuranceType?
  documentNumber   String
  issueDate        DateTime?
  expiryDate       DateTime
  fileUrl          String
  originalName     String
  mimeType         String
  sizeBytes        Int
  status           DocumentStatus @default(PENDING)
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionReason  String?
  supersededAt     DateTime?
  lastReminderDays Int?
  createdAt        DateTime       @default(now())

  @@index([vehicleId, type])
  @@index([status, expiryDate])
  @@index([ownerId, vehicleId, type, supersededAt])
  @@map("vehicle_documents")
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  title        String
  body         String
  data         Json?
  readAt       DateTime?
  emailSentAt  DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model CarpoolRide {
  id             String     @id @default(uuid())
  driverId       String
  driver         User       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  originText     String
  originLat      Decimal    @db.Decimal(9, 6)
  originLng      Decimal    @db.Decimal(9, 6)
  destText       String
  destLat        Decimal    @db.Decimal(9, 6)
  destLng        Decimal    @db.Decimal(9, 6)
  distanceKm     Decimal?   @db.Decimal(7, 2)
  departureTime  DateTime
  totalSeats     Int
  availableSeats Int
  costPerSeat    Decimal    @db.Decimal(10, 2)
  notes          String?
  status         RideStatus @default(OPEN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, departureTime])
  @@index([driverId])
  @@index([vehicleId, status, departureTime])
  @@map("carpool_rides")
}
